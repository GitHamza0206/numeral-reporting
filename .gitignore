# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# python
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual diff CLI default output
/visual-diff-output/

# local data (directory tracked via .gitkeep only)
/data/**
!/data/.gitkeep
!/data/README.md

# optional frozen questionnaire params (keep example committed)
/client_context.json
